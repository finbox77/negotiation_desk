# Куда Vite проксирует /api в режиме разработки и preview.
# Это адрес основного сайта Simonix (npm run dev в корне репозитория).
DESK_API_PROXY=http://localhost:3000

# Адрес сайта для ссылки «Войти на сайте» и перехода в кабинет.
# Если не задан, приложение выведет http://localhost:3000.
VITE_DESK_SITE_URL=http://localhost:3000

# Режим по умолчанию: demo | site. Демо работает без бэкенда.
VITE_DESK_MODE=demo

# Базовый путь API. Пустая строка = /api/v1 (через прокси или same-origin).
# Менять вручную нужно только при выкладывании PWA на отдельный домен.
VITE_DESK_API_BASE=
